classDiagram
  class ProcesoDeLaPizarra {
    -hilo_principal: Visor
    -hilo_secundario: ServidorMCP
    -salida: CodigoDeSalida
    +run()
    +cerrar()
  }
  class ServidorMCP {
    -pizarra: Pizarra
    -peaje: usize
    +show(id, doc)
    +clear()
    +vivas()
  }
  class Visor {
    +mostrar(svg)
    +ocultar()
    +despedirse()
  }
  class Pizarra {
    -vistas: Map~str, Vista~
    -orden: Vec~str~
    +reemplazar(id, vista)
    +olvidar_todo()
  }
  class Vista {
    +id: str
    +documento: VisualDocument
    +svg: str
    +generacion: u32
  }
  class Lanzador {
    +exec()
    +chmod()
  }
  class ServidorDeAviso {
    +anunciar()
  }
  ProcesoDeLaPizarra *-- ServidorMCP
  ProcesoDeLaPizarra *-- Visor
  ServidorMCP *-- Pizarra
  Pizarra o-- Vista
  ServidorMCP ..> Visor : envia SVG
  Lanzador ..> ProcesoDeLaPizarra : lanza
  Lanzador ..> ServidorDeAviso : si no puede
