classDiagram
  class Visor {
    +aplicar(evento)
  }
  class Evento {
    +tipo: str
    +view_id: str
  }
  class Pizarra {
    -vistas: Map~str, Vista~
    -bus: Bus
    +reemplazar(id, vista)
  }
  class Bus {
    +publicar(evento)
  }
  class Vista {
    +id: str
    +svg: str
  }
  Pizarra --> Bus : publica
  Bus --> Evento
  Bus ..> Visor : entrega
  Pizarra o-- Vista
